
# Which docker-compose file to use by default
COMPOSE_FILE=docker-compose.yaml

# Command line for docker-compose.
# You may need to modify it, as some Docker confugurations use "docker compose" configuration.
#COMPOSE_CL="docker compose"
COMPOSE_CL="docker-compose"

# docker-compose stack name
COMPOSE_PROJECT_NAME=blnk

# Blnk project name
BLNK_PROJECT_NAME=Blnk

# Timezone
TZ=Etc/UTC

# Server details
BLNK_SERVER_SSL_DOMAIN=
BLNK_SERVER_SSL_EMAIL=
BLNK_SERVER_SSL=
BLNK_SERVER_PORT=

# DNS details
BLNK_DATA_SOURCE_DNS=
BLNK_REDIS_DNS=

# Postgres credentials
#POSTGRES_IMAGE=postgres:latest
POSTGRES_IMAGE=postgres:alpine3.19 #alphine version is smaller in size
POSTGRES_CONTAINER=pg_server
POSTGRES_OUTER_PORT=5432
POSTGRES_INNER_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD={POSTGRES_PASSWORD}
POSTGRES_DB=blnk
POSTGRES_SCHEMA=blnk

# ---- recon-agent dedicated database role (least privilege) ----
#
# The recon-agent MUST NOT connect as the Postgres superuser. On first boot the
# postgres service runs recon-agent/deploy/agent-db-init.sh, which provisions a
# dedicated, NON-superuser role that OWNS (and is confined to) the `agent`
# schema and has no rights on Blnk's `blnk.*` tables. The two variables below
# define that role's credentials and are consumed by BOTH the postgres service
# (to create the role) and the recon-agent service (in AGENT_DATABASE_URL) — so
# they MUST stay synchronized.
#
# SECURITY: change AGENT_POSTGRES_PASSWORD to a strong secret before any
# non-local deployment; the default here exists only for the local demo.
AGENT_POSTGRES_USER=recon_agent
AGENT_POSTGRES_PASSWORD=recon_agent_pw

# ---- recon-agent (LLM reconciliation exception-resolution sidecar) ----

# OpenAI-compatible Chat Completions endpoint that serves the open-source Kimi K3 model.
#
# SECURITY: The default below is a NON-ROUTABLE, loopback-only placeholder — it is
# deliberately NOT a live third-party provider (config-safety, Rule 5.6). Copying
# these defaults and running the agent must never silently transmit transaction
# bodies (PII) to a public SaaS endpoint. Point this at YOUR OWN OpenAI-compatible
# endpoint explicitly:
#   - a self-hosted server on localhost (e.g. vLLM or Ollama, the port shown below), or
#   - a hosted provider you have chosen (e.g. https://api.moonshot.ai/v1).
# If nothing is listening at LLM_BASE_URL the classifier fails closed and every
# break is routed to HITL (Rule 5.7) — the safe outcome.
#
# Validation (enforced at startup, fail-fast): must be an ABSOLUTE http:// or
# https:// URL that includes a host and has NO embedded userinfo/credentials
# (do not put a token in the URL — use LLM_API_KEY below).
LLM_BASE_URL=http://localhost:11434/v1
# API key/token for the LLM endpoint above. Leave blank to force fail-closed → HITL.
LLM_API_KEY=
# Model name passed on every inference request. Config-driven; never hardcode in code.
# Required and must not be blank.
LLM_MODEL=kimi-k3

# Base URL of the Blnk reconciliation API.
# Host-side (make seed / make demo) uses the published port on localhost.
# NOTE: the docker-compose recon-agent service overrides this to http://server:5001 internally.
# Same URL rules as LLM_BASE_URL: absolute http(s), host required, no embedded userinfo.
BLNK_BASE_URL=http://localhost:5001
# Value sent in the X-Blnk-Key header on every Blnk request (Blnk API-key auth).
BLNK_API_KEY=

# Auto-remediation gate: the agent auto-acts ONLY when confidence >= threshold AND the break is not regulated.
CONF_AUTO_THRESHOLD=0.85

# OPTIONAL independent (non-LLM) regulated backstop (INFO#2, defense-in-depth for
# finding F-1). When set to the ledger's settlement/base currency, the agent
# treats ANY break whose currency differs from it as regulated REGARDLESS of the
# classifier's LLM-sourced regulated flag, so a prompt-injection that flips
# regulated=false can never open the auto path for a foreign-currency break. It
# sits ABOVE the always-on deterministic cohort dry-run (which itself cannot match
# across currencies, Rule 5.3). Leave BLANK to disable the backstop (the cohort
# dry-run still guards clearance). Case-insensitive (e.g. USD).
AGENT_BASE_CURRENCY=USD

# Port for the recon-agent HITL review API + server-rendered status page.
HITL_PORT=8088

# PostgreSQL DSN for the agent-owned tables (agent schema) inside the shared blnk database.
# Connects as the DEDICATED, least-privilege role (AGENT_POSTGRES_USER /
# AGENT_POSTGRES_PASSWORD above) — NOT the Postgres superuser (M-13). The
# user:password here MUST match those two variables. Host-side uses the
# published Postgres port on localhost.
# NOTE: the docker-compose recon-agent service overrides the host to `postgres`
# internally and derives this DSN from AGENT_POSTGRES_USER/AGENT_POSTGRES_PASSWORD.
AGENT_DATABASE_URL=postgres://recon_agent:recon_agent_pw@localhost:5432/blnk?sslmode=disable
