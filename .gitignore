blnk
*/node_modules
node_modules
.env
.idea
blnk.json
promtail
dump.rdb
heartbeat.db
.claude
CLAUDE.md
__pycache__
tests/loadtest/*.json
tests/loadtest/*.ndjson
# Compressed raw streams. `NDJSON_OUT=...gz` is the documented way to keep a long run's
# per-request detail, because k6 gzips a destination whose name asks for it — so the same
# artifact the two globs above already ignore arrives under a third extension. Without this
# the recommended form is the only one that leaves the tree dirty, which reads as the
# recommendation being wrong.
tests/loadtest/*.gz
# In-flight artifacts. run_case.sh writes k6's output to a `.partial.<pid>-<epoch>.` marked
# name and promotes it only after a clean exit, removing it on EXIT, INT and TERM. A SIGKILL
# outruns those traps, and a surviving temporary must not be stageable as a result.
tests/loadtest/.partial.*

# Rendered Kubernetes manifests, produced by `make k8s_render` / scripts/k8s-preflight.sh
# --render. These are COPIES of infrastructure/k8s-manifests with the application image
# resolved to a concrete digest, and they must never be committed: the committed manifests
# deliberately carry an unresolvable placeholder so that an apply cannot silently run a
# build other than the one intended. A digest checked in here would defeat that.
/rendered/

# Scratch files written by `make alerts_configmap`: the alert rule file as the Kubernetes
# ConfigMap projects it, plus a unit-test file pointed at that projection. Both are removed
# on exit and are dot-prefixed so the rule_files glob (alerts/*.yml, non-recursive) cannot
# see them even mid-run; they are listed here so an interrupted run cannot leave one staged.
/alerts/tests/.configmap-projection.yml
/alerts/tests/.configmap-projection_test.yml
/alerts/tests/.configmap-infra-projection.yml
